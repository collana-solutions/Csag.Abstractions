<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The private Azure DevOps feed, for Csag.Abstractions.UnitTests only. That project is not in the
         solution, so CI never restores from this feed and needs no credentials for it. -->
    <add key="neolution" value="https://neolution.pkgs.visualstudio.com/_packaging/neolution/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="neolution">
      <package pattern="Neolution.Extensions.DependencyInjection" />
    </packageSource>
  </packageSourceMapping>
  <!-- NuGet Audit asks every package source for vulnerability data. Without credentials the private feed
       answers with 401, which fails the audit of that source with warning NU1900. nuget.org has the
       vulnerability data for every package. -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
