<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Drops the sources of machine-level and user-level NuGet.Config files, so every restore uses nuget.org only. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <!-- NuGet Audit merges the audit sources of machine-level and user-level NuGet.Config files as well, so this
       list starts empty too. -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
